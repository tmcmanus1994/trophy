# Copy to .env.local and fill in from your Supabase project
# (Project Settings -> API). The site works without these — progress
# just stays in localStorage on each device until they're set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Single-user namespace. No auth — this string keys every progress row.
NEXT_PUBLIC_USER_KEY=travelle

# Phase 2 only (PSN Profiles auto-sync). Leave empty for now.
PSN_PROFILES_ID=
CRON_SECRET=
